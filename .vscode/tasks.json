{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run tests for this exercise",
            "detail": "Ctrl+Shift+B while an exercise file is open",
            "type": "shell",
            "command": "python",
            "args": ["${file}"],
            "options": { "cwd": "${fileDirname}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "clear": true, "focus": false },
            "problemMatcher": []
        },
        {
            "label": "Primer progress",
            "detail": "Shows every lesson's status and what to do next",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/python-primer/progress.py"],
            "presentation": { "reveal": "always", "clear": true },
            "problemMatcher": []
        }
    ]
}
